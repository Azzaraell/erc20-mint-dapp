# Copy to .env and fill in. NEVER commit the real .env (it is gitignored).

# Deployer private key (use a NEW testnet-only wallet, never your main wallet).
# Works with or without the 0x prefix when passed via --private-key on the CLI.
PRIVATE_KEY=your_testnet_private_key_here

# RPC endpoint (Ethereum Sepolia)
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# For contract verification on Etherscan (free key at etherscan.io)
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# Optional token config overrides (defaults baked into Deploy.s.sol)
TOKEN_NAME=Mint Token
TOKEN_SYMBOL=MINT
TOKEN_MAX_SUPPLY=1000000
TOKEN_MINT_PRICE=1000000000000000
